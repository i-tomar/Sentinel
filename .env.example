# Copy to .env and fill in. Never commit .env.
# Every value here is read by sentinel.config.Settings; unknown keys are rejected.

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=mock            # openai|google|anthropic|groq|mock  (mock = deterministic, no key needed)
LLM_MODEL=                   # groq: e.g. openai/gpt-oss-120b
LLM_API_KEY=
LLM_JUDGE_MODEL=             # optional eval judge model (same provider and key); default LLM_MODEL
GROQ_REASONING_EFFORT=low    # low|medium|high, gpt-oss models on groq only
LLM_RATE_LIMIT_RETRIES=6     # groq: resends after HTTP 429
LLM_RATE_LIMIT_MAX_WAIT_S=120  # groq: longest single 429 wait; longer stops an eval run

# --- Embeddings --------------------------------------------------------------
EMBEDDING_PROVIDER=local     # local (fastembed, no key) | hash (offline, tests) | openai | google
EMBEDDING_MODEL=

# --- Data sources ------------------------------------------------------------
DATA_MODE=fixture            # fixture|live
MAX_HOPS=4
TOOL_TIMEOUT_S=10
TOOL_BUDGET_S=60             # all tool calls in one turn; none start after this

# --- Storage -----------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333   # or :memory: / a directory path for embedded Qdrant
QDRANT_COLLECTION=sentinel_chunks  # the embedder name is appended, e.g. sentinel_chunks_hash384
CHECKPOINT_DB=./.data/checkpoints.sqlite
MEMORY_BACKEND=sqlite        # sqlite|okf
MEMORY_DB=./.data/memory.sqlite
FIXTURE_STATE_DIR=./.data/fixture-state   # approved fixture writes; delete to reset
MEMORY_AUTO_APPROVE=false    # agent memory writes without approval; refused with DATA_MODE=live
OKF_DIR=./.data/okf

# --- Tracing -----------------------------------------------------------------
TRACING_BACKEND=none         # langfuse|langsmith|none (langfuse/langsmith require the keys below)
# Local Langfuse: `make up`, then paste the output of `uv run sentinel infra app-env` here.
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel

# --- Live connectors (DATA_MODE=live only; every request is read-only) -------
# Check with `uv run sentinel live check` (no network). Enable sources one at a time.
LIVE_SOURCES=notion          # comma-separated subset of notion,jira,gmail
LIVE_MAX_RECORDS=200         # per-source cap for one live ingest
NOTION_TOKEN=                # internal integration secret; share only the pages it may read
JIRA_BASE_URL=               # https://<site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=              # Atlassian API token (acts with your account's permissions)
JIRA_PROJECT_KEYS=           # optional, e.g. PROJ,OPS: restricts every search to these projects
GMAIL_CLIENT_ID=             # OAuth "Desktop app" client; consent with `sentinel live gmail-auth`
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=         # printed by `sentinel live gmail-auth` (gmail.readonly only)
GMAIL_MCP_COMMAND=           # optional: own Gmail MCP server exposing search_threads/get_thread

# --- Guardrails & permissions ------------------------------------------------
ALLOWED_EMAIL_DOMAINS=acme.test   # comma-separated
INJECTION_THRESHOLD=0.5
RETRIEVED_GUARD_MODE=remove       # remove | quote: flagged spans in retrieved data
AUDIT_LOG=./.data/audit.jsonl
APPROVAL_DB=./.data/approvals.sqlite
APPROVAL_TTL_S=900                # seconds a proposed write stays approvable
