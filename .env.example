# Copy to .env and fill in. Never commit .env.
# Every value here is read by sentinel.config.Settings; unknown keys are rejected.

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=mock            # openai|google|anthropic|mock  (mock = deterministic, no key needed)
LLM_MODEL=
LLM_API_KEY=

# --- Embeddings --------------------------------------------------------------
EMBEDDING_PROVIDER=local     # local (fastembed, no key) | hash (offline, tests) | openai | google
EMBEDDING_MODEL=

# --- Data sources ------------------------------------------------------------
DATA_MODE=fixture            # fixture|live
MAX_HOPS=4
TOOL_TIMEOUT_S=10

# --- Storage -----------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333   # or :memory: / a directory path for embedded Qdrant
QDRANT_COLLECTION=sentinel_chunks  # the embedder name is appended, e.g. sentinel_chunks_hash384
CHECKPOINT_DB=./.data/checkpoints.sqlite
MEMORY_BACKEND=sqlite        # sqlite|okf
MEMORY_DB=./.data/memory.sqlite
OKF_DIR=./.data/okf

# --- Tracing -----------------------------------------------------------------
TRACING_BACKEND=none         # langfuse|langsmith|none (langfuse/langsmith require the keys below)
# Local Langfuse: `make up`, then paste the output of `uv run sentinel infra app-env` here.
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel

# --- Live connectors (DATA_MODE=live only) -----------------------------------
NOTION_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GMAIL_MCP_COMMAND=           # command/URL of the chosen Gmail MCP server (read-only scopes)

# --- Guardrails & permissions ------------------------------------------------
ALLOWED_EMAIL_DOMAINS=acme.test   # comma-separated
INJECTION_THRESHOLD=0.5
AUDIT_LOG=./.data/audit.jsonl
